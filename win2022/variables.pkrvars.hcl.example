# Copy to variables.pkrvars.hcl and fill in. Do not commit real values.
# Pass the token via env instead if you prefer:  export PKR_VAR_proxmox_token=...

proxmox_url      = "https://PROXMOX_HOST:8006/api2/json"
proxmox_username = "USER@REALM!TOKEN_NAME"
proxmox_token    = "SECRET_TOKEN"
proxmox_node     = "PROXMOX_NODE_NAME"

iso_file        = "local:iso/WINDOWS_SRV2022.iso"
iso_checksum    = "sha256:SHA256SUM"
virtio_iso_file = "local:iso/virtio-win.iso"
storage_pool    = "pool1"
vm_id           = 9000
template_name   = "win2022-tpl"

# Build-time Administrator password. Clones are set to this password on first
# boot unless you override it, so change it per environment.
admin_password = "CHANGE_ME!"
